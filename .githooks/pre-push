#!/bin/sh
# Checks every commit about to be pushed, including ones made before the
# hooks were enabled or with --no-verify. See tool/check_for_leaks.sh.
root=$(git rev-parse --show-toplevel)
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # $range is split into separate arguments on purpose.
  "$root/tool/check_for_leaks.sh" $range || status=1
done
exit $status
